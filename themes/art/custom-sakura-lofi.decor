{
  "about": "Decor for the custom-sakura-lofi theme, read by the agents-spaces mod (JSON). font: a brush font in ~/.config/herdr-app/fonts. titles: brush title per space name on the title card (title: for any other space). calligraphy: faint vertical brush text at the bottom left, only where the list leaves room. seal: the red seal on the title card. states: one kanji before each state. sheen: the pink glass rising from the bottom of the agents panel. sky: the live sky for that place (sun, moon in its phase, stars, light of the hour, weather from MET Norway), behind the terminal area; update_minutes: how often its picture may change (default 20); add preview: { at, symbol, cloud, wind } to freeze a look. backdrop: the landscape behind the terminal area (transparent sky), shown through the terminals at terminal_opacity.",
  "font": "Yuji Boku",
  "title": "夜桜",
  "titles": { "Dagens arbeid": "今日の仕事" },
  "calligraphy": "風林火山",
  "seal": "風",
  "seal_color": "#b9382e",
  "seal_text": "#f6efe2",
  "states": { "attention": "急", "working": "動", "idle": "静" },
  "sheen": "#f2a7c3",
  "sky": { "place": "Oslo", "lat": 59.91, "lon": 10.75, "update_minutes": 20 },
  "backdrop": "themes/art/backdrops/custom-sakura-lofi.svg",
  "terminal_opacity": 0.6
}
